root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,asmdef,asmref}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Unity owns serialization formatting; do not reformat imported assets.
[*.{unity,prefab,asset,mat,meta,anim,controller,overrideController,playable}]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = unset
